# AI 视频安监检测系统环境变量配置示例
# 复制本文件为 .env 后根据实际环境修改，.env 不会被提交到 Git。
# 所有变量都有默认值（见 src/config/config.py），不配置时使用默认值。

# =============================================================================
# 日志
# =============================================================================
# 日志级别：DEBUG / INFO / WARNING / ERROR / CRITICAL
AIDETECTION_LOG_LEVEL=INFO

# 日志文件路径（默认 logs/app.log）
# AIDETECTION_LOG_FILE=logs/app.log

# 禁用控制台输出（仅写入文件）：1 表示禁用，空表示启用
# AIDETECTION_LOG_DISABLE_CONSOLE=

# =============================================================================
# ascend-sam3 推理服务，按算法使用常规预测和目标精细化接口
# =============================================================================
SAM3_URL=http://192.168.100.75:18002/predict
SAM3_URL_REFINE=http://192.168.100.75:18002/predict-obj-refine
# SAM3_URL_REFINE 未配置时，默认使用 SAM3_URL 同一服务下的 predict-obj-refine 路径。
# 单实例或网关的完整地址；上游默认对外端口为 18000，请按实际部署修改。
# 兼容旧变量：未分组算法的默认地址，不设置时自动使用 SAM3_URL。
# SAM3_URL_OBJ=http://192.168.100.75:18002/predict
SAM3_TIMEOUT_SECONDS=30

# =============================================================================
# 任务/告警平台
# =============================================================================
GET_TASK_URL=http://192.168.100.73/open/api/operate/taskList
GET_FENCE_URL=http://192.168.100.73/open/api/operate/fence
GET_RTSP_URL=http://192.168.100.73/open/api/operate/previewURLs
UPLOAD_URL=http://192.168.100.73/open/api/operate/upload

# =============================================================================
# gRPC RTSP 流媒体后端（C++ 服务）
# =============================================================================
# 使用 Docker bridge 网络时，用 grpc_rtsp 服务名访问；使用 host 网络时改为 localhost:50051
STREAM_SERVER_ADDRESS=grpc_rtsp:50051

# 流恢复：两次重建之间的最小冷却（秒）
# STREAM_RECOVERY_COOLDOWN_SEC=10.0

# =============================================================================
# Triton YOLO 推理服务
# =============================================================================
# HTTP 端口（共享内存/HTTP 调用时使用）
TRITON_YOLO_URL=triton-ascend:8000
# gRPC 端口（推荐，避免 gevent/libev 文件描述符开销）
TRITON_YOLO_GRPC_URL=triton-ascend:8001
TRITON_PROTOCOL=grpc
# 分类复核暂不启用；后续提供昇腾分类模型后单独配置接口。

# =============================================================================
# VL 大模型二次复核（可选）
# =============================================================================
VL_ENABLED=true
VL_API_URL=http://192.168.100.75:18000/v1
VL_MODEL=/models/qwen3-vl-4b

# 大模型 API 密钥，自部署服务通常留空即可
VL_API_KEY=

# 是否开启模型思考链：true / false
VL_ENABLE_THINKING=true

# =============================================================================
# 业务参数
# =============================================================================
# 任务同步间隔（秒）
REQUEST_INTERVAL=10

# 违章原图本地保存根目录
VIOLATION_IMAGE_SAVE_DIR=/mnt/yolo/images

# =============================================================================
# 共享内存命名空间
# =============================================================================
# 同一宿主机运行多个项目时，通过不同命名空间隔离 /dev/shm 中的流数据。
# 默认与已部署的 RTSP 服务共用宿主机 /dev/shm/grpc_rtsp。
# 首次部署前请在宿主机创建：mkdir -p /dev/shm/${SHM_NAMESPACE}
SHM_NAMESPACE=grpc_rtsp

# =============================================================================
# 外部依赖服务 Compose 文件路径
# =============================================================================
# docker-compose.yml 会通过 include 引入这些文件。路径相对于本 docker-compose.yml。
# 默认值已指向项目内的 docker-compose.empty.yml，避免未部署外部服务时构建失败。
# 如需启用真实服务，请取消注释并修改为实际路径。
# GRPC_RTSP_COMPOSE=../grpc_rtsp/docker-compose.yml
# 昇腾主机使用上游 CPU-only 编排时（路径按实际部署调整）：
# GRPC_RTSP_COMPOSE=../rtspGrpcServer/docker-compose.cpu.yml
# 同一 Compose 网络内同时将 STREAM_SERVER_ADDRESS 改为 grpc_rtsp_cpu:50051。
# 两端 SHM_NAMESPACE 必须一致，且实际挂载同一个宿主机目录。
# TRITON_COMPOSE=../triton-inference-server-ascend/docker-compose.yml

# =============================================================================
# 容器运行时
# =============================================================================
PYTHONUNBUFFERED=1
TZ=Asia/Shanghai

# Docker 构建基础镜像，用于 Docker Hub 访问受限时切换到镜像仓库
# 例如：AIDETECTION_BASE_IMAGE=registry.cn-hangzhou.aliyuncs.com/library/python:3.13-slim-bookworm
# AIDETECTION_BASE_IMAGE=python:3.13-slim-bookworm
